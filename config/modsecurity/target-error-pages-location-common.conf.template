location /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "OK";
}

location /metrics/nginx {
    access_log off;
    allow ${METRICS_ALLOW_FROM};
    deny ${METRICS_DENY_FROM};
    proxy_store off;
    stub_status;
}

error_page 403 /cybertrace-errors/403.html;
error_page 500 /cybertrace-errors/500.html;
error_page 502 /cybertrace-errors/502.html;
error_page 503 /cybertrace-errors/503.html;
error_page 504 /cybertrace-errors/504.html;

location = /cybertrace-error-page.css {
    root /usr/share/nginx/html/cybertrace-errors;
    default_type text/css;
    charset utf-8;
    access_log off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /cybertrace-errors/ {
    internal;
    root /usr/share/nginx/html;
    default_type text/html;
    charset utf-8;
    access_log /dev/null combined;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-CyberTrace-Transaction-ID $request_id always;

    more_set_headers 'Access-Control-Allow-Headers: *';
    more_set_headers -s 403 'Access-Control-Allow-Origin: *';
    more_set_headers -s 403 'Access-Control-Max-Age: 3600';
    more_set_headers -s 403 'Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS';
}
