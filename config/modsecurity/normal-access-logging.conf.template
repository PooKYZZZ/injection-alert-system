# Successful target workflows are triaged separately because ModSecurity's
# RelevantOnly audit log intentionally omits ordinary 2xx/3xx transactions.
# Search Records and Track Status inputs are inspected synchronously by the
# portal before protected reads; do not ingest those same request IDs again
# after the response. Bare page loads have no user input to classify.
# Exclude Next.js RSC prefetches from the remaining allowlisted GETs.
map "${CYBERTRACE_NORMAL_ACCESS_TELEMETRY}|$request_method|$uri|$status|$arg__rsc" $cybertrace_normal_access_loggable {
    default 0;
    ~^true\|GET\|/(?:records/[A-Za-z0-9-]+|appointments|support|login|comments|records/[A-Za-z0-9-]+/request-copy)\|[23][0-9][0-9]\|$ 1;
}

log_format cybertrace_normal escape=json
    '{'
        '"transaction_id":"$request_id",'
        '"timestamp":"$time_iso8601",'
        '"source_ip":"$remote_addr",'
        '"cf_connecting_ip":"$http_cf_connecting_ip",'
        '"proxy_peer_ip":"$realip_remote_addr",'
        '"request_method":"$request_method",'
        '"request_path":"$uri",'
        '"query_string":"$args",'
        '"status":$status'
    '}';
