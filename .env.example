# ─────────────────────────────────────────────────────────────────
# CyberTrace Backend — Environment Variables
# Copy this file: cp .env.example .env
# Do not commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# Database
# sqlite+aiosqlite for local development.
# For Supabase/Postgres, replace with your direct connection string:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres
# Use transaction pooler URL instead if deploying to serverless or IPv4-only environments.
DATABASE_URL=sqlite+aiosqlite:///./injection_alerts.db

# ML Model paths
# Download model files from the team shared drive.
# See: ml_model/model_registry/staging/README.md
# If the path is wrong or empty, the app starts in mock mode automatically.
MODEL_PATH=web_app
MODEL_REGISTRY_PATH=web_app

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# Security
# Leave empty in local development — auth is bypassed when this is empty.
# Set a strong random value in production.
API_SECRET_KEY=

# CORS — allow the frontend to call the backend
ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional — only needed for LLM/Groq features, not required for core functionality
GROQ_API_KEY=

# Confidence thresholds (do not change without explicit approval)
CONFIDENCE_LOW_THRESHOLD=0.50
CONFIDENCE_HIGH_THRESHOLD=0.80

# Model inference settings
STALE_PROCESSING_TIMEOUT_SECONDS=30
MAX_SEQ_LEN=128
TEMPERATURE=0.596868
