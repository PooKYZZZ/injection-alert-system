# ─────────────────────────────────────────────────────────────────
# CyberTrace Backend — Environment Variables
# Copy this file: cp .env.example .env
# Do not commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# Database
# sqlite+aiosqlite for local development.
# For Supabase/Postgres, replace with your direct connection string:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres
# Use transaction pooler URL instead if deploying to serverless or IPv4-only environments.
# Normal Docker development uses docker-compose.local.yml and overrides this
# value with its isolated PostgreSQL service. The base Compose migration command
# fails closed when this value identifies a remote database.
DATABASE_URL=sqlite+aiosqlite:///./runtime/injection_alerts.db

# ML Model paths
# Download model files from the team shared drive.
# See: ml_model/model_registry/staging/README.md
# If the path is wrong or empty, the app starts in mock mode automatically.
MODEL_PATH=ml_model/model_registry
# Supported values:
# - ml_model/model_registry (auto-picks latest staged distilbert run in dev/test)
# - ml_model/model_registry/staging/<distilbert_run_dir> (explicit run directory)
MODEL_REGISTRY_PATH=ml_model/model_registry

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# Security
# Leave empty in local development — auth is bypassed when this is empty.
# Set a strong random value in production.
API_SECRET_KEY=
# Generate independently; do not reuse API_SECRET_KEY.
WAF_INGEST_API_KEY=
# Shared only by the WAF audit bridge and the backend. Keep the real value in
# the ignored .env file; do not commit it or expose it to the frontend.
WAF_AUDIT_EVIDENCE_KEY=
# Portable path for the target-only Cloudflare tunnel token. The secret folder
# is intentionally outside the repository and must be created on each host.
CLOUDFLARED_TARGET_TOKEN_FILE=../CyberTrace-Secrets/cloudflared-target.token
# Safe default. Do not enable verified provenance without completing the
# independent Cloudflare/origin proof documented in the hosted runbook.
CLOUDFLARE_TARGET_VERIFIED_PROOF=false
# unverified | cloudflare_tunnel
WAF_SOURCE_VERIFICATION_MODE=unverified
ENFORCEMENT_MODE=off
# PR7 CRITICAL mutation is disabled by default and restricted to controlled
# development/testing. It also requires WAF_STATE_SYNC_ENABLED=true and
# ENFORCEMENT_MODE=enforce; keep hosted/staging/production disabled.
PR7_CRITICAL_WAF_MUTATION_ENABLED=false
PR7_WAF_CAPACITY=64
# Required by the PR7 snapshot synchroniser when enabled.
WAF_STATE_SYNC_ENABLED=false
WAF_STATE_SYNC_API_KEY=
# Required when ENFORCEMENT_MODE is shadow or enforce; generate independently.
ENFORCEMENT_CHECK_API_KEY=
ENFORCEMENT_RECOMMENDATION_TTL_SECONDS=900
ENFORCEMENT_LOW_WINDOW_SECONDS=60
ENFORCEMENT_LOW_MAX_UNCHALLENGED_REQUESTS=5
ENFORCEMENT_MEDIUM_WINDOW_SECONDS=60
ENFORCEMENT_MEDIUM_MAX_REQUESTS=10
ENFORCEMENT_CHALLENGE_GRANT_TTL_SECONDS=300
# Server-only enforcement Turnstile configuration; never expose the secret.
ENFORCEMENT_TURNSTILE_SECRET_KEY=
ENFORCEMENT_TURNSTILE_EXPECTED_HOSTNAME=
ENFORCEMENT_TURNSTILE_TIMEOUT_SECONDS=3
# Explicit controlled-test mode for Cloudflare's published dummy credentials only.
ENFORCEMENT_TURNSTILE_TEST_MODE=false
# Mark cloudflare_verified only after direct-origin and proxy-header topology proof.
ENFORCEMENT_SOURCE_TRUST_MODE=unverified
# Controlled local/test-only source bypass. Must remain false in staging/production.
ENFORCEMENT_ALLOW_UNVERIFIED_SOURCE_FOR_TESTS=false
# Bridge evidence source: direct_remote_addr or cloudflare_connecting_ip.
WAF_SOURCE_PROVENANCE_MODE=direct_remote_addr
# Required only by docker-compose.hosted-target.yml after observing the tunnel peer.
# Keep the observed narrow value in the ignored root .env; do not set it only in
# a temporary shell and do not widen it to a Docker network or 0.0.0.0/0.
HOSTED_WAF_TRUSTED_PEER=

# Durable notification worker (disabled unless explicitly enabled)
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_REQUIRED=false
NOTIFICATION_WORKER_POLL_SECONDS=2
NOTIFICATION_WORKER_BATCH_SIZE=1
NOTIFICATION_WORKER_LEASE_SECONDS=60
# Shared server-only AES-256-GCM key used by Next.js producers and the worker.
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY=
EMAIL_PROVIDER=fake
THREAT_EMAIL_ENABLED=false
THREAT_EMAIL_TO=
# Telegram threat notifications — server only. Never commit real values.
THREAT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LIVE_TEST_ENABLED=false
NOTIFICATION_TIMEZONE=Asia/Manila
DASHBOARD_BASE_URL=http://localhost:3000

# Dashboard retraining is disabled by default. Native mode requires the
# training dependencies and the prepared v2 dataset described in the laptop
# training guide; keep smoke for ordinary development and CI.
RETRAINING_ENABLED=false
RETRAINING_WORKER_MODE=smoke
# Set true and rebuild the backend image before selecting native mode in Compose.
INSTALL_TRAINING_REQUIREMENTS=false

# Optional realistic demo target source. The default Compose path expects a
# separate checkout of this repository's stable/portal-pre-waf branch beside
# the CyberTrace checkout at ../injection-alert-system-portal-pre-waf.
# Override this only when the portal checkout is elsewhere.
# DEMO_PORTAL_CONTEXT=../injection-alert-system-portal-pre-waf

# Resend server-only configuration. Never commit a real API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_LIVE_TEST_ENABLED=false

# CORS — allow the frontend to call the backend
ALLOWED_ORIGINS=["http://localhost:3000"]

# Confidence thresholds (do not change without explicit approval)
CONFIDENCE_LOW_THRESHOLD=0.50
CONFIDENCE_HIGH_THRESHOLD=0.80

# Model inference settings
STALE_PROCESSING_TIMEOUT_SECONDS=30
MAX_SEQ_LEN=128
TEMPERATURE=0.596868
