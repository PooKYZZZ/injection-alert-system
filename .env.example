# ─────────────────────────────────────────────────────────────────
# CyberTrace Backend — Environment Variables
# Copy this file: cp .env.example .env
# Do not commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# Database
# sqlite+aiosqlite for local development.
# For Supabase/Postgres, replace with your direct connection string:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres
# Use transaction pooler URL instead if deploying to serverless or IPv4-only environments.
DATABASE_URL=sqlite+aiosqlite:///./injection_alerts.db

# ML Model paths
# Download model files from the team shared drive.
# See: ml_model/model_registry/staging/README.md
# If the path is wrong or empty, the app starts in mock mode automatically.
MODEL_PATH=ml_model/model_registry
# Supported values:
# - ml_model/model_registry (auto-picks latest staged distilbert run in dev/test)
# - ml_model/model_registry/staging/<distilbert_run_dir> (explicit run directory)
MODEL_REGISTRY_PATH=ml_model/model_registry

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# Security
# Leave empty in local development — auth is bypassed when this is empty.
# Set a strong random value in production.
API_SECRET_KEY=
# Generate independently; do not reuse API_SECRET_KEY.
WAF_INGEST_API_KEY=
# unverified | cloudflare_tunnel
WAF_SOURCE_VERIFICATION_MODE=unverified
ENFORCEMENT_MODE=off
# Required only when ENFORCEMENT_MODE=shadow; generate independently.
ENFORCEMENT_CHECK_API_KEY=
ENFORCEMENT_RECOMMENDATION_TTL_SECONDS=900
# Bridge evidence source: direct_remote_addr or cloudflare_connecting_ip.
WAF_SOURCE_PROVENANCE_MODE=direct_remote_addr
# Required only by docker-compose.hosted-target.yml after observing the tunnel peer.
# Keep the observed narrow value in the ignored root .env; do not set it only in
# a temporary shell and do not widen it to a Docker network or 0.0.0.0/0.
HOSTED_WAF_TRUSTED_PEER=

# Durable notification worker (disabled unless explicitly enabled)
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_REQUIRED=false
NOTIFICATION_WORKER_POLL_SECONDS=2
NOTIFICATION_WORKER_BATCH_SIZE=1
NOTIFICATION_WORKER_LEASE_SECONDS=60
# Shared server-only AES-256-GCM key used by Next.js producers and the worker.
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY=
EMAIL_PROVIDER=fake
THREAT_EMAIL_ENABLED=false
THREAT_EMAIL_TO=
# Telegram threat notifications — server only. Never commit real values.
THREAT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LIVE_TEST_ENABLED=false
DASHBOARD_BASE_URL=http://localhost:3000

# Resend server-only configuration. Never commit a real API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_LIVE_TEST_ENABLED=false

# CORS — allow the frontend to call the backend
ALLOWED_ORIGINS=["http://localhost:3000"]

# Confidence thresholds (do not change without explicit approval)
CONFIDENCE_LOW_THRESHOLD=0.50
CONFIDENCE_HIGH_THRESHOLD=0.80

# Model inference settings
STALE_PROCESSING_TIMEOUT_SECONDS=30
MAX_SEQ_LEN=128
TEMPERATURE=0.596868
