FROM python:3.14-slim

WORKDIR /app

COPY scripts/waf_audit_bridge.py ./scripts/waf_audit_bridge.py
COPY web_app/__init__.py ./web_app/__init__.py
COPY web_app/domain/__init__.py ./web_app/domain/__init__.py
COPY web_app/domain/source_address.py ./web_app/domain/source_address.py

CMD ["python", "-m", "scripts.waf_audit_bridge", "--help"]
