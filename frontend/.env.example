# ─────────────────────────────────────────────────────────────────
# CyberTrace Frontend — Environment Variables
# Copy this file: cp .env.example .env.local
# Do not commit .env.local — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# Backend URL — must match where uvicorn is running
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Internal API key — must match API_SECRET_KEY in backend .env
# Leave empty in local development
INTERNAL_API_KEY=

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000

# Auth.js v5 signing secret for JWT sessions.
# Generate a secure value by running: npx auth secret
# This MUST be set in production; without it Auth.js will throw an error
# or fall back to an insecure auto-generated secret that changes on restart,
# invalidating all existing sessions.
AUTH_SECRET=

# Password used for the SOC demo credentials login.
# Only a password is required; no username is checked.
SOC_DEMO_PASSWORD=demopass123

# Legacy fallback name still accepted by the login code.
DEMO_PASSWORD=

# Set to true to run frontend without a running backend (uses mock data)
USE_MOCK_API=false

# Application environment (development | staging | production).
NEXT_PUBLIC_APP_ENV=development

# Application version string (e.g. 1.2.3 or 0.0.0-LOCAL).
NEXT_PUBLIC_APP_VERSION=0.0.0-LOCAL
