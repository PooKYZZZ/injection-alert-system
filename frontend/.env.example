# Auth.js v5 signing secret for JWT sessions.
# Generate a secure value by running: npx auth secret
# This MUST be set in production; without it Auth.js will throw an error
# or fall back to an insecure auto-generated secret that changes on restart,
# invalidating all existing sessions.
AUTH_SECRET=

# Password used for the SOC demo credentials login.
# Only a password is required; no username is checked.
# Password used by the credentials provider for SOC demo login.
SOC_DEMO_PASSWORD=

# Backend API base URL used by Next.js server-side route handlers (API proxy).
# Do NOT expose this to the browser — omit the NEXT_PUBLIC_ prefix.
FASTAPI_BASE_URL=http://localhost:8000

# Internal API key used to authenticate server-to-server requests.
INTERNAL_API_KEY=

# Groq API key used by the /api/explain proxy route to call the LLM.
# Never expose this to the browser — omit the NEXT_PUBLIC_ prefix.
GROQ_API_KEY=

# Enable mock stats data (opt-in). Set to "true" in development when no backend
# is available. Never set in production — leave unset or set to "false".
USE_MOCK_STATS=

# Application environment (development | staging | production).
NEXT_PUBLIC_APP_ENV=development

# Application version string (e.g. 1.2.3 or 0.0.0-LOCAL).
NEXT_PUBLIC_APP_VERSION=0.0.0-LOCAL
