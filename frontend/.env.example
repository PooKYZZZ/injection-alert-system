# Auth.js v5 signing secret for JWT sessions.
# Generate a secure value by running: npx auth secret
# This MUST be set in production; without it Auth.js will throw an error
# or fall back to an insecure auto-generated secret that changes on restart,
# invalidating all existing sessions.
AUTH_SECRET=

# Backend API base URL used by Next.js server-side route handlers (API proxy).
# Do NOT expose this to the browser — omit the NEXT_PUBLIC_ prefix.
BACKEND_API_URL=http://localhost:8000

# Groq API key used by the /api/explain proxy route to call the LLM.
# Never expose this to the browser — omit the NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
