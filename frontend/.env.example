# ─────────────────────────────────────────────────────────────────
# CyberTrace Frontend — Environment Variables
# Copy this file: cp .env.example .env.local
# Do not commit .env.local — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# Backend URL — must match where uvicorn is running
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Internal API key — must match API_SECRET_KEY in backend .env
# Leave empty in local development
INTERNAL_API_KEY=

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000

# Auth.js v5 signing secret for JWT sessions.
# Generate a secure value by running: npx auth secret
# This MUST be set in production; without it Auth.js will throw an error
# or fall back to an insecure auto-generated secret that changes on restart,
# invalidating all existing sessions.
AUTH_SECRET=

# Server-only account database access. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# V6.1 ADMIN account management. Keep disabled until migrations and MFA sessions are ready.
AUTH_APP_ORIGIN=http://localhost:3000
AUTH_ACCOUNT_MANAGEMENT_ENABLED=false

# Enable the server-authorized TOTP enrollment boundary after Unit 4 claims are ready.
AUTH_MFA_ENROLLMENT_ENABLED=false
# Base64 (or 64-character hex) encoding of one random 32-byte AES-256-GCM key.
AUTH_MFA_ENCRYPTION_KEY=
# Dedicated server-only key for email recovery OTP HMAC digests (32+ bytes).
AUTH_EMAIL_OTP_KEY=
# Shared server-only AES-256-GCM key used by notification producers and worker.
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY=
# Keep email recovery disabled until the verified-email/outbox deployment is ready.
AUTH_EMAIL_RECOVERY_ENABLED=false
# Keep password reset disabled until the verified-email/outbox deployment is ready.
AUTH_PASSWORD_RESET_ENABLED=false
# Optional threshold-triggered Turnstile boundary; keep disabled for local development.
AUTH_TURNSTILE_ENABLED=false
AUTH_TURNSTILE_SECRET_KEY=
AUTH_TURNSTILE_EXPECTED_HOSTNAME=

# Set to true to run frontend without a running backend (uses mock data)
USE_MOCK_API=false

# Application environment (development | staging | production).
NEXT_PUBLIC_APP_ENV=development

# Application version string (e.g. 1.2.3 or 0.0.0-LOCAL).
NEXT_PUBLIC_APP_VERSION=0.0.0-LOCAL
