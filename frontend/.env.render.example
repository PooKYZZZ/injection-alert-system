# Render production template for frontend
# Copy values into Render service environment settings.

AUTH_SECRET=<strong-random-secret>
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://<frontend-service>.onrender.com
SOC_DEMO_PASSWORD=<strong-demo-password>
DEMO_PASSWORD=
FASTAPI_BASE_URL=https://<backend-service>.onrender.com
INTERNAL_API_KEY=<same-value-as-backend-API_SECRET_KEY>
USE_MOCK_API=false
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_VERSION=1.0.0
